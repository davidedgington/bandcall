<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, maximum-scale=1"
  />

  <title>BandCall</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #080808;
      color: #ffffff;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
    }

    .page {
      width: 100%;
      max-width: 600px;
      margin: 0 auto;
      padding: 35px 22px 80px;
    }

    .logo {
      font-size: 34px;
      font-weight: 900;
      letter-spacing: 5px;
    }

    .loading {
      color: #888;
      margin-top: 50px;
      font-size: 16px;
    }

    .event {
      font-size: 28px;
      font-weight: 800;
      margin-top: 45px;
    }

    .subtitle {
      color: #888;
      margin-top: 8px;
      margin-bottom: 28px;
      font-size: 15px;
    }

    .option {
      width: 100%;
      background: #171717;
      color: white;
      border: 1px solid #292929;
      border-radius: 18px;
      padding: 19px;
      margin-bottom: 12px;
      text-align: left;
      cursor: pointer;
    }

    .option.selected {
      border-color: #ffffff;
    }

    .option-title {
      font-size: 16px;
      font-weight: 900;
    }

    .option-description {
      color: #777;
      margin-top: 5px;
      font-size: 13px;
    }

    .form {
      display: none;
      border-top: 1px solid #222;
      margin-top: 28px;
      padding-top: 18px;
    }

    label {
      display: block;
      color: #aaa;
      font-size: 14px;
      font-weight: 700;
      margin: 15px 0 9px;
    }

    input,
    textarea {
      width: 100%;
      border: 0;
      outline: none;
      background: #202020;
      color: white;
      border-radius: 13px;
      padding: 16px;
      font-size: 16px;
    }

    textarea {
      min-height: 110px;
      resize: vertical;
    }

    #songList {
      margin-top: 12px;
    }

    .song {
      background: #171717;
      border: 1px solid #292929;
      border-radius: 14px;
      padding: 15px;
      margin-bottom: 9px;
      cursor: pointer;
    }

    .song.selected {
      border-color: white;
    }

    .song-title {
      color: white;
      font-size: 16px;
      font-weight: 800;
    }

    .artist {
      color: #777;
      font-size: 14px;
      margin-top: 3px;
    }

    .send {
      width: 100%;
      background: white;
      color: #080808;
      border: 0;
      border-radius: 14px;
      padding: 18px;
      font-size: 15px;
      font-weight: 900;
      margin-top: 22px;
      cursor: pointer;
    }

    .error {
      color: #ff8c8c;
      margin-top: 14px;
      line-height: 20px;
    }

    .success {
      display: none;
      text-align: center;
      padding-top: 100px;
    }

    .success-icon {
      font-size: 70px;
      font-weight: 900;
    }

    .success-title {
      font-size: 30px;
      font-weight: 900;
      margin-top: 15px;
    }

    .success-text {
      color: #888;
      margin-top: 10px;
      margin-bottom: 25px;
    }

    .not-live {
      display: none;
      background: #171717;
      border: 1px solid #292929;
      border-radius: 18px;
      padding: 22px;
      margin-top: 45px;
    }

    .not-live-title {
      font-size: 20px;
      font-weight: 800;
    }

    .not-live-text {
      color: #888;
      margin-top: 7px;
      line-height: 21px;
    }

    .footer {
      color: #333;
      text-align: center;
      font-size: 11px;
      margin-top: 50px;
    }
  </style>
</head>

<body>

  <div class="page">

    <div class="logo">
      BandCall
    </div>

    <div id="loading" class="loading">
      Joining gig...
    </div>

    <div id="main" style="display:none">

      <div id="eventName" class="event"></div>

      <div class="subtitle">
        What would you like to do?
      </div>

      <div id="options"></div>

      <div id="form" class="form">

        <label>Your name</label>

        <input
          id="audienceName"
          placeholder="e.g. Dave"
        />

        <div id="songArea" style="display:none">

          <label>Choose a song</label>

          <input
            id="search"
            placeholder="Search songs or artists..."
          />

          <div id="songList"></div>

        </div>

        <div id="shoutoutArea" style="display:none">

          <label>Your shout-out</label>

          <textarea
            id="message"
            placeholder="Happy birthday Sarah from everyone at table 6!"
          ></textarea>

        </div>

        <div id="error" class="error"></div>

        <button
          id="submitButton"
          class="send"
          onclick="submitRequest()"
        >
          SEND REQUEST
        </button>

      </div>

    </div>

    <div id="notLive" class="not-live">

      <div class="not-live-title">
        Gig not found
      </div>

      <div class="not-live-text">
        This BandCall session isn't currently live.
        Check the QR code and try again.
      </div>

    </div>

    <div id="success" class="success">

      <div class="success-icon">
        ✓
      </div>

      <div class="success-title">
        REQUEST SENT!
      </div>

      <div class="success-text">
        Your request has been sent to the band.
      </div>

      <button
        class="send"
        onclick="resetPage()"
      >
        SEND ANOTHER
      </button>

    </div>

    <div class="footer">
      BandCall
    </div>

  </div>


<script>

const SUPABASE_URL =
  'https://qfxkdwyssbhnwkboprwi.supabase.co';

const SUPABASE_KEY =
  'sb_publishable_C9S6VHNun6EW0p2LIog2zw_XIgXe3PX';

const headers = {
  apikey: SUPABASE_KEY,
  'Content-Type': 'application/json'
};

let gig = null;
let songs = [];

let selectedType = null;
let selectedSongId = null;


// ----------------------------
// GET GIG CODE FROM URL
// ----------------------------

const params =
  new URLSearchParams(
    window.location.search
  );

const gigCode =
  (params.get('code') || '')
    .trim()
    .toUpperCase();


// ----------------------------
// LOAD GIG
// ----------------------------

async function loadBandCall() {

  if (!gigCode) {

    showNotLive();

    return;
  }

  try {

    const gigResponse =
      await fetch(
        SUPABASE_URL +
        '/rest/v1/gigs' +
        '?code=eq.' +
        encodeURIComponent(gigCode) +
        '&is_live=eq.true' +
        '&select=*',
        {
          headers
        }
      );

    if (!gigResponse.ok) {

      throw new Error(
        await gigResponse.text()
      );

    }

    const gigs =
      await gigResponse.json();

    if (!gigs.length) {

      showNotLive();

      return;
    }

    gig = gigs[0];


    // LOAD SONGS

    const songResponse =
      await fetch(
        SUPABASE_URL +
        '/rest/v1/songs' +
        '?profile_id=eq.' +
        gig.profile_id +
        '&active=eq.true' +
        '&select=*' +
        '&order=title.asc',
        {
          headers
        }
      );

    if (!songResponse.ok) {

      throw new Error(
        await songResponse.text()
      );

    }

    songs =
      await songResponse.json();


    document.getElementById(
      'eventName'
    ).textContent =
      gig.event_name;


    buildOptions();


    document.getElementById(
      'loading'
    ).style.display =
      'none';


    document.getElementById(
      'main'
    ).style.display =
      'block';

  }

  catch (error) {

    console.error(error);

    document.getElementById(
      'loading'
    ).textContent =
      'Could not connect to BandCall.';

  }

}


// ----------------------------
// BUILD OPTIONS
// ----------------------------

function buildOptions() {

  const options =
    document.getElementById(
      'options'
    );

  options.innerHTML = '';


  if (gig.allow_requests) {

    options.appendChild(

      createOption(
        'song',
        '🎵 REQUEST A SONG',
        'Pick something from our song list'
      )

    );

  }


  if (gig.allow_singing) {

    options.appendChild(

      createOption(
        'sing',
        '🎤 SING WITH US',
        'Come up and perform with the band'
      )

    );

  }


  if (gig.allow_shoutouts) {

    options.appendChild(

      createOption(
        'shoutout',
        '📣 SEND A SHOUT-OUT',
        'Birthday, dedication or message'
      )

    );

  }

}


// ----------------------------
// CREATE OPTION
// ----------------------------

function createOption(
  type,
  title,
  description
) {

  const button =
    document.createElement(
      'button'
    );

  button.className =
    'option';


  const titleDiv =
    document.createElement(
      'div'
    );

  titleDiv.className =
    'option-title';

  titleDiv.textContent =
    title;


  const descriptionDiv =
    document.createElement(
      'div'
    );

  descriptionDiv.className =
    'option-description';

  descriptionDiv.textContent =
    description;


  button.appendChild(
    titleDiv
  );

  button.appendChild(
    descriptionDiv
  );


  button.onclick =
    () => {

      selectType(
        type,
        button
      );

    };


  return button;

}


// ----------------------------
// SELECT TYPE
// ----------------------------

function selectType(
  type,
  button
) {

  selectedType =
    type;

  selectedSongId =
    null;


  document
    .querySelectorAll(
      '.option'
    )
    .forEach(
      item =>
        item.classList.remove(
          'selected'
        )
    );


  button.classList.add(
    'selected'
  );


  document.getElementById(
    'form'
  ).style.display =
    'block';


  const songArea =
    document.getElementById(
      'songArea'
    );

  const shoutoutArea =
    document.getElementById(
      'shoutoutArea'
    );


  if (
    type === 'song' ||
    type === 'sing'
  ) {

    songArea.style.display =
      'block';

    shoutoutArea.style.display =
      'none';

    renderSongs('');

  }

  else {

    songArea.style.display =
      'none';

    shoutoutArea.style.display =
      'block';

  }


  const submit =
    document.getElementById(
      'submitButton'
    );


  if (type === 'song') {

    submit.textContent =
      'SEND SONG REQUEST';

  }

  else if (type === 'sing') {

    submit.textContent =
      'ASK TO SING';

  }

  else {

    submit.textContent =
      'SEND SHOUT-OUT';

  }

}


// ----------------------------
// SONG SEARCH
// ----------------------------

document.getElementById(
  'search'
).addEventListener(
  'input',
  function () {

    renderSongs(
      this.value
    );

  }
);


// ----------------------------
// SHOW SONGS
// ----------------------------

function renderSongs(
  searchText
) {

  const holder =
    document.getElementById(
      'songList'
    );

  holder.innerHTML =
    '';


  const search =
    searchText
      .toLowerCase()
      .trim();


  const filtered =
    songs.filter(
      song => {

        const title =
          (
            song.title ||
            ''
          ).toLowerCase();

        const artist =
          (
            song.artist ||
            ''
          ).toLowerCase();


        return (
          title.includes(
            search
          ) ||
          artist.includes(
            search
          )
        );

      }
    );


  filtered.forEach(
    song => {

      const card =
        document.createElement(
          'div'
        );

      card.className =
        'song';


      if (
        selectedSongId ===
        song.id
      ) {

        card.classList.add(
          'selected'
        );

      }


      const title =
        document.createElement(
          'div'
        );

      title.className =
        'song-title';

      title.textContent =
        song.title;


      const artist =
        document.createElement(
          'div'
        );

      artist.className =
        'artist';

      artist.textContent =
        song.artist || '';


      card.appendChild(
        title
      );

      card.appendChild(
        artist
      );


      card.onclick =
        () => {

          selectedSongId =
            song.id;

          renderSongs(
            document.getElementById(
              'search'
            ).value
          );

        };


      holder.appendChild(
        card
      );

    }
  );

}


// ----------------------------
// SUBMIT REQUEST
// ----------------------------

async function submitRequest() {

  const error =
    document.getElementById(
      'error'
    );

  error.textContent =
    '';


  const name =
    document.getElementById(
      'audienceName'
    )
    .value
    .trim();


  if (!selectedType) {

    error.textContent =
      'Choose an option first.';

    return;

  }


  if (!name) {

    error.textContent =
      'Please enter your name.';

    return;

  }


  if (
    (
      selectedType === 'song' ||
      selectedType === 'sing'
    ) &&
    !selectedSongId
  ) {

    error.textContent =
      'Please choose a song.';

    return;

  }


  const message =
    document.getElementById(
      'message'
    )
    .value
    .trim();


  if (
    selectedType ===
      'shoutout' &&
    !message
  ) {

    error.textContent =
      'Please enter your message.';

    return;

  }


  const button =
    document.getElementById(
      'submitButton'
    );

  button.disabled =
    true;

  button.textContent =
    'SENDING...';


  try {

    const response =
      await fetch(
        SUPABASE_URL +
        '/rest/v1/requests',
        {

          method:
            'POST',

          headers: {
            ...headers,
            Prefer:
              'return=minimal'
          },

          body:
            JSON.stringify({

              gig_id:
                gig.id,

              song_id:
                (
                  selectedType ===
                    'song' ||
                  selectedType ===
                    'sing'
                )
                  ? selectedSongId
                  : null,

              request_type:
                selectedType,

              audience_name:
                name,

              message:
                selectedType ===
                  'shoutout'
                  ? message
                  : null,

              status:
                'new'

            })

        }
      );


    if (!response.ok) {

      throw new Error(
        await response.text()
      );

    }


    document.getElementById(
      'main'
    ).style.display =
      'none';


    document.getElementById(
      'success'
    ).style.display =
      'block';

  }

  catch (err) {

    console.error(err);

    error.textContent =
      'Could not send your request. Please try again.';

    button.disabled =
      false;

    button.textContent =
      'SEND REQUEST';

  }

}


// ----------------------------
// RESET
// ----------------------------

function resetPage() {

  selectedType =
    null;

  selectedSongId =
    null;


  document.getElementById(
    'audienceName'
  ).value =
    '';


  document.getElementById(
    'message'
  ).value =
    '';


  document.getElementById(
    'search'
  ).value =
    '';


  document.getElementById(
    'form'
  ).style.display =
    'none';


  document.getElementById(
    'success'
  ).style.display =
    'none';


  document.getElementById(
    'main'
  ).style.display =
    'block';


  document
    .querySelectorAll(
      '.option'
    )
    .forEach(
      item =>
        item.classList.remove(
          'selected'
        )
    );


  document.getElementById(
    'submitButton'
  ).disabled =
    false;

}


// ----------------------------
// NOT LIVE
// ----------------------------

function showNotLive() {

  document.getElementById(
    'loading'
  ).style.display =
    'none';

  document.getElementById(
    'notLive'
  ).style.display =
    'block';

}


// ----------------------------
// START
// ----------------------------

loadBandCall();

</script>

</body>
</html>
